<?xml version="1.0" encoding="utf-8"?>
<!--
   Devices older than API 31 only support cloud backup. Character data must not leave the device
   through that channel, so every app-owned domain is excluded. Local device-to-device transfer on
   newer Android versions is governed by data_extraction_rules.xml.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
