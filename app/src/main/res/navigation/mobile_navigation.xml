<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:startDestination="@+id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.softwaremagico.librodeesher.android.ui.character.CharacterCreationFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:layout="@layout/fragment_character_creation" />

    <fragment
        android:id="@+id/navigation_random"
        android:name="com.softwaremagico.librodeesher.android.ui.random.RandomCharacterFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:layout="@layout/fragment_random_character" />

    <fragment
        android:id="@+id/navigation_sheet"
        android:name="com.softwaremagico.librodeesher.android.ui.sheet.SheetFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:layout="@layout/fragment_sheet" />

    <fragment
        android:id="@+id/navigation_wiki"
        android:name="com.softwaremagico.librodeesher.android.ui.wiki.WikiFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:layout="@layout/fragment_wiki" />
</navigation>
