<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:startDestination="@+id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.softwaremagico.librodeesher.android.ui.character.tabbed.TabbedCharacterFragment"
        android:label="@string/navigation_character"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:layout="@layout/fragment_character_tabbed" />

    <fragment
        android:id="@+id/navigation_assistant"
        android:name="com.softwaremagico.librodeesher.android.ui.assistant.CharacterAssistantFragment"
        android:label="@string/navigation_assistant"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:layout="@layout/fragment_assistant" />

    <fragment
        android:id="@+id/navigation_random"
        android:name="com.softwaremagico.librodeesher.android.ui.random.RandomCharacterEnhancedFragment"
        android:label="@string/navigation_random"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:layout="@layout/fragment_random_character_enhanced" />

    <fragment
        android:id="@+id/navigation_characteristics"
        android:name="com.softwaremagico.librodeesher.android.ui.characteristics.CharacteristicsFragment"
        android:label="@string/navigation_characteristics"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:layout="@layout/fragment_characteristics" />

    <fragment
        android:id="@+id/navigation_sheet"
        android:name="com.softwaremagico.librodeesher.android.ui.sheet.SheetFragment"
        android:label="@string/navigation_visualization"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:layout="@layout/fragment_sheet" />

    <fragment
        android:id="@+id/navigation_skills"
        android:name="com.softwaremagico.librodeesher.android.ui.skills.SkillsFragment"
        android:label="@string/navigation_skills"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:layout="@layout/fragment_skills" />

    <fragment
        android:id="@+id/navigation_spells"
        android:name="com.softwaremagico.librodeesher.android.ui.spells.SpellsFragment"
        android:label="@string/navigation_spells"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:layout="@layout/fragment_spells" />

    <fragment
        android:id="@+id/navigation_perks"
        android:name="com.softwaremagico.librodeesher.android.ui.perks.PerksFragment"
        android:label="@string/navigation_perks"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:layout="@layout/fragment_perks" />

    <fragment
        android:id="@+id/navigation_resistances"
        android:name="com.softwaremagico.librodeesher.android.ui.resistances.ResistancesFragment"
        android:label="@string/navigation_resistances"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:layout="@layout/fragment_resistances" />

    <fragment
        android:id="@+id/navigation_history"
        android:name="com.softwaremagico.librodeesher.android.ui.history.HistoryFragment"
        android:label="@string/navigation_history"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:layout="@layout/fragment_history" />

    <fragment
        android:id="@+id/navigation_equipment"
        android:name="com.softwaremagico.librodeesher.android.ui.equipment.EquipmentFragment"
        android:label="@string/navigation_equipment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:layout="@layout/fragment_equipment" />

    <fragment
        android:id="@+id/navigation_weapon_tiers"
        android:name="com.softwaremagico.librodeesher.android.ui.weapontiers.WeaponTiersFragment"
        android:label="@string/navigation_weapon_tiers"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:layout="@layout/fragment_weapon_tiers" />

    <fragment
        android:id="@+id/navigation_wiki"
        android:name="com.softwaremagico.librodeesher.android.ui.wiki.WikiFragment"
        android:label="@string/navigation_wiki"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:layout="@layout/fragment_wiki" />
</navigation>
