<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/assistant_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/assistant_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingBottom="16dp" />

        <TextView
            android:id="@+id/assistant_step_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/assistant_description"
            android:textSize="16sp"
            android:paddingBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="16dp">

            <Button
                android:id="@+id/assistant_prev_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Anterior" />

            <Button
                android:id="@+id/assistant_next_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Siguiente" />
        </LinearLayout>

        <Button
            android:id="@+id/assistant_finish_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Finalizar"
            android:visibility="gone" />

        <Button
            android:id="@+id/assistant_save_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save_character"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/assistant_export_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/export_pdf"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/assistant_share_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/share_pdf"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/assistant_summary_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="14sp"
            android:textIsSelectable="true" />

    </LinearLayout>

</ScrollView>
