<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/random_preferences"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/random_specialization"
            android:paddingTop="8dp" />

        <SeekBar
            android:id="@+id/random_specialization_seekbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="6"
            android:progress="3" />

        <TextView
            android:id="@+id/random_specialization_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0" />

        <Button
            android:id="@+id/random_apply_prefs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/random_use_defaults"
            android:layout_marginTop="16dp" />

    </LinearLayout>

</ScrollView>
