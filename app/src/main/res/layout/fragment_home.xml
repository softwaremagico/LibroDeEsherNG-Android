<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Libro de Esher"
        android:textSize="24sp"
        android:textStyle="bold"
        android:paddingBottom="32dp" />

    <Button
        android:id="@+id/home_new_character"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nuevo Personaje"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/home_assistant"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Asistente de Creación"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/home_random"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Generación Aleatoria"
        android:layout_marginBottom="16dp" />

</LinearLayout>
